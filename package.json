{
  "name": "@sean2077/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "sean2077 <37324769+sean2077@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://sean2077.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/sean2077/quartz-site.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "docs": "npx quartz build --serve -d docs",
    "precheck": "npm run install-plugins",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "npx quartz plugin install",
    "prebuild": "npm run install-plugins",
    "build": "npx quartz build -d obsidian-vault --concurrency 8",
    "dev": "npx wrangler pages dev public",
    "deploy": "npx wrangler pages deploy public --project-name=sean2077 --branch=main",
    "release": "npm run build && npm run deploy"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@floating-ui/dom": "^1.8.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.1.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.6.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.40.0",
    "lightningcss": "^1.33.0",
    "lucide-static": "1.27.0",
    "micromorph": "^0.4.5",
    "minimatch": "^10.1.1",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.1",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.6",
    "sharp": "^0.35.3",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.1.1",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
